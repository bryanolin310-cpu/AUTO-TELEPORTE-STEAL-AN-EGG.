-- 🔄 FUNÇÃO DE TELEPORTE
local function TeleportToNearestEgg()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local root = character.HumanoidRootPart
    local nearestEgg = nil
    local minDistance = math.huge

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.match(string.lower(v.Name), "egg") or string.match(string.lower(v.Name), "ovo") then
            local dist = (v.Position - root.Position).Magnitude
            if dist < minDistance and dist < 500 then
                minDistance = dist
                nearestEgg = v
            end
        end
    end

    if nearestEgg then
        root.CFrame = CFrame.new(nearestEgg.Position + Vector3.new(0, 3, 0))
        print("[PIMENTA] Teleportado para: " .. nearestEgg.Name)
    end
end

-- 📦 FUNÇÃO DE COLETAR
local function CollectEgg()
    local character = LocalPlayer.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        firetouchinterest:Fire(hrp, 1)
        print("[PIMENTA] Tentando coletar...")
    end
end

-- 👁️ SISTEMA ESP
local ESPObjects = {}
local function CreateESP(part, name)
    if ESPObjects[part] then return end
    
    local esp = Instance.new("BillboardGui")
    esp.Name = "EggESP"
    esp.AlwaysOnTop = true
    esp.Size = UDim2.new(0, 100, 0, 30)
    esp.Parent = part
    
    local txt = Instance.new("TextLabel")
    txt.BackgroundTransparency = 1
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.Font = Enum.Font.GothamBold
    txt.Text = "🥚 " .. name
    txt.TextColor3 = Color3.fromRGB(255, 200, 0)
    txt.TextSize = 14
    txt.Parent = esp
    
    ESPObjects[part] = esp
end

-- 🔁 LOOP DE DETECÇÃO
game:GetService("RunService").Heartbeat:Connect(function()
    if Config.ESP_Enabled then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") and (string.match(string.lower(v.Name), "egg") or string.match(string.lower(v.Name), "ovo")) then
                if not ESPObjects[v] then
                    CreateESP(v, v.Name)
                end
            end
        end
    end
end)

-- ⌨️ TECLAS DE ATALHO
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    
    if input.KeyCode == Config.Keybind_TP then
        TeleportToNearestEgg()
    elseif input.KeyCode == Config.Keybind_Collect then
        CollectEgg()
    end
end)

