-- ==============================================
-- 🎯 TP OVO + VOLTA BASE
-- ==============================================

local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 🏠 SALVAR POSIÇÃO DA BASE AO CARREGAR
local PosicaoBase = nil
task.wait(2) -- Espera carregar o personagem
if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
    PosicaoBase = LocalPlayer.Character.HumanoidRootPart.CFrame
    print("🏠 Posição da base salva!")
end

-- 🥚 TELEPORTA PRO OVO MAIS PERTO
local function TP_Ovo()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local alvo, dist = nil, math.huge

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and (string.find(string.lower(v.Name), "egg") or string.find(string.lower(v.Name), "ovo")) then
            local d = (v.Position - hrp.Position).Magnitude
            if d < dist and d < 500 then
                dist = d
                alvo = v
            end
        end
    end

    if alvo then
        hrp.CFrame = CFrame.new(alvo.Position + Vector3.new(0, 3, 0))
        print("🥚 TP → " .. alvo.Name)
        -- 📦 PEGA OVO AUTOMÁTICO
        task.wait(0.1)
        firetouchinterest:Fire(alvo, 0)
        task.wait(0.05)
        firetouchinterest:Fire(alvo, 1)
        print("✅ Ovo coletado!")
    else
        print("⚠️ Nenhum ovo encontrado!")
    end
end

-- 🏠 VOLTA PRA BASE
local function VoltarBase()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not PosicaoBase then return end
    char.HumanoidRootPart.CFrame = PosicaoBase
    print("🏠 Voltei pra base!")
end

-- ⌨️ TECLAS
UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.E then TP_Ovo() end      -- E = Ir no ovo + pegar
    if i.KeyCode == Enum.KeyCode.Q then VoltarBase() end  -- Q = Voltar pra base
end)

print("✅ CARREGADO! | E = Ovo | Q = Voltar Base")
 
