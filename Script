-- 🎯 ACHAR OVO MAIS PERTO
local function AcharOvo()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    local alvo, dist = nil, math.huge

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local nome = string.lower(v.Name)
            if string.find(nome, "egg") or string.find(nome, "ovo") then
                local d = (v.Position - hrp.Position).Magnitude
                if d < dist and d <= Config.MaxDistancia then
                    dist = d
                    alvo = v
                end
            end
        end
    end
    return alvo
end

-- 🚀 TP + PEGAR OVO
local function TP_Ovo()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local ovo = AcharOvo()

    if ovo then
        hrp.CFrame = CFrame.new(ovo.Position + Vector3.new(0, Config.AlturaOvo, 0))
        task.wait(0.15)
        firetouchinterest:Fire(ovo, 0)
        task.wait(0.05)
        firetouchinterest:Fire(ovo, 1)
        return true
    end
    return false
end

-- 🏠 VOLTAR BASE
local function VoltarBase()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not PosicaoBase then return end
    char.HumanoidRootPart.CFrame = PosicaoBase
end

